AEGIS_APP_NAME=AegisAI
AEGIS_ENVIRONMENT=local
AEGIS_DATABASE_URL=postgresql+asyncpg://aegis:aegis@postgres:5432/aegisai
AEGIS_REDIS_URL=redis://redis:6379/0
AEGIS_AUTO_CREATE_SCHEMA=false
AEGIS_RATE_LIMIT_REQUESTS=100
AEGIS_RATE_LIMIT_WINDOW_SECONDS=60
AEGIS_AUTH_MODE=hybrid
AEGIS_ALLOW_DEV_API_KEYS=true
AEGIS_JWT_ISSUER=
AEGIS_JWT_AUDIENCE=
AEGIS_JWT_JWKS_URL=
AEGIS_JWT_JWKS_JSON=
AEGIS_JWT_ALGORITHMS='["RS256"]'
AEGIS_JWT_CLOCK_SKEW_SECONDS=30
AEGIS_LLM_PROVIDER=local
AEGIS_OPENAI_API_KEY=
AEGIS_OPENAI_MODEL=gpt-4.1-mini
AEGIS_ANTHROPIC_API_KEY=
AEGIS_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
AEGIS_LLM_TIMEOUT_SECONDS=30
AEGIS_LLM_MAX_RETRIES=2
AEGIS_SUPPORT_RETRIEVER=fixture
AEGIS_RAG_VECTOR_STORE=memory
AEGIS_QDRANT_URL=http://qdrant:6333
AEGIS_QDRANT_COLLECTION=sentinel_aegis_chunks
AEGIS_EMBEDDING_DIMENSIONS=32
AEGIS_RAG_CHUNK_SIZE=700
AEGIS_RAG_CHUNK_OVERLAP=100
AEGIS_TELEMETRY_ENABLED=true
AEGIS_OTLP_ENDPOINT=
AEGIS_EVENT_BUS=memory
AEGIS_REDPANDA_BOOTSTRAP_SERVERS=redpanda:9092
AEGIS_SECURITY_EVENTS_TOPIC=sentinel-aegis.security-events

# Phase 7: regression fixtures and report artifacts
AEGIS_REGRESSION_FIXTURES_DIR=./regression/cases
AEGIS_REPORT_ARTIFACTS_DIR=./artifacts

# Phase 8: HTTP hardening. Leave CORS empty to disable cross-origin access entirely;
# wildcards are rejected when AEGIS_ENVIRONMENT=production.
AEGIS_CORS_ALLOW_ORIGINS='[]'
AEGIS_CORS_ALLOW_CREDENTIALS=false
AEGIS_MAX_REQUEST_BYTES=1000000
AEGIS_SECURITY_HEADERS_ENABLED=true
AEGIS_HSTS_MAX_AGE_SECONDS=31536000

# Phase 8: secrets. Any secret-bearing setting accepts a reference instead of a
# literal, e.g. AEGIS_ANTHROPIC_API_KEY=secret://file/anthropic_api_key
AEGIS_SECRETS_PROVIDER=env
AEGIS_SECRETS_FILE_DIR=/run/secrets
AEGIS_AWS_SECRETS_REGION=
AEGIS_AWS_SECRETS_PREFIX=sentinel-aegis/

AEGIS_API_BASE_URL=http://backend:8000
AEGIS_FRONTEND_API_KEY=dev-aegis-key

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LOCAL_LLM_BASE_URL=
